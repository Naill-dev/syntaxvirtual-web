{
  "version": 2,
  "rewrites": [
    {
      "source": "/lab/(.*)",
      "destination": "https://syntaxvirtual-lab.vercel.app/lab/$1"
    },
    {
      "source": "/lab",
      "destination": "https://syntaxvirtual-lab.vercel.app/lab"
    },
    {
      "source": "/_next/(.*)",
      "destination": "https://syntaxvirtual-lab.vercel.app/_next/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lab/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
